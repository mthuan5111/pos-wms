{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER_NAME_OR_IP;Database=POS_WMS_DB;User Id=YOUR_SQL_USERNAME;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
  "CloudinarySettings": {
    "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  
  "Jwt": {
    "Key": "REPLACE_THIS_WITH_A_VERY_SECRET_KEY_MINIMUM_32_CHARS!",
    "Issuer": "POS_WMS_Backend",
    "Audience": "POS_WMS_MobileApp",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  
  "Cors": {
    "AllowedOrigins": [
      "https://pos-wms-frontend.com",
      "http://localhost:8081",
      "http://localhost:8082",
      "http://localhost:3000",
      "http://127.0.0.1:8081",
      "http://127.0.0.1:8082"
    ]
  },
  
  "SeedPasswords": {
    "Admin": "REPLACE_WITH_STRONG_ADMIN_PASSWORD",
    "Manager": "REPLACE_WITH_STRONG_MANAGER_PASSWORD",
    "Cashier": "REPLACE_WITH_STRONG_CASHIER_PASSWORD",
    "Warehouse": "REPLACE_WITH_STRONG_WAREHOUSE_PASSWORD"
  }
}
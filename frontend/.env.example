# API Base URL for POS-WMS Backend (Cloud Run or Local LAN/Development)
# Note: In production, HTTPS is required by apiClient
EXPO_PUBLIC_API_URL=https://your-backend-api-domain.com/api

# Cloudinary unsigned upload configuration for product images
# NOTE: EXPO_PUBLIC_* variables are exposed to client-side code.
# Never place API Secret or private keys here.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

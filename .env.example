# ==============================================================================
# POS-WMS Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR SENSITIVE CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Backend API Configuration
DEMO_API_HOST=127.0.0.1
DEMO_API_PORT=5050

# Demo User Credentials for Automated Testing
# Provide test account credentials before running test_demo_auth.cjs
DEMO_VIEWER_USERNAME=demo_viewer
DEMO_VIEWER_PASSWORD=your_demo_viewer_password_here

# Cloudinary Storage Configuration (Client-side asset management)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
